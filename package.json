{
  "name": "msg.client.web",
  "private": true,
  "version": "0.1.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && chmod -R 755 dist/icons && chmod 644 dist/manifest.json dist/sw.js dist/logo.png 2>/dev/null || true",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "proto:generate": "buf generate --path proto/messenger.proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@connectrpc/connect": "^1.6.1",
    "@connectrpc/connect-web": "^1.6.1",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@improbable-eng/grpc-web": "^0.15.0",
    "grpc-web": "^2.0.2",
    "protobufjs": "^8.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.12.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.11",
    "vite-plugin-static-copy": "^1.0.6",
    "vitest": "^4.1.9"
  }
}
